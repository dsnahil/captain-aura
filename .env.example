# ============================================================================
# CAPTAIN AURA — environment
#
# Every variable here is OPTIONAL. With an empty .env.local the app runs fully:
# deterministic rule-based recommendations plus live keyless weather.
# ============================================================================

# ---------------------------------------------------------------- AI advisor
# Without this, recommendations come from the built-in rules engine.
# With it, Captain Aura uses the AI provider and falls back to the rules
# engine automatically if the call fails.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------------- weather
# Weather uses Open-Meteo, which is free and needs no API key or account.
# Set to "mock" to force deterministic simulated weather (offline demos).
# WEATHER_PROVIDER=mock

# ------------------------------------------------------------------ geocoding
# City search uses Open-Meteo geocoding (also keyless).
# Set to "offline" to use the small built-in city list instead.
# GEOCODE_PROVIDER=offline

# -------------------------------------------------------------------- vision
# Garment recognition for closet photos. Requires ANTHROPIC_API_KEY.
# Without it, colour is still detected on-device and you confirm the rest.
# VISION_PROVIDER=mock

# ------------------------------------------------------------ recommendations
# Force the deterministic engine even when an AI key is present.
# RECOMMENDATION_PROVIDER=rules

# ----------------------------------------------------------------------- site
# Used for absolute URLs in metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------ Firebase
# Optional. Without these the app still works fully — it just saves to this
# device instead of an account. These values are public by design: Firebase
# identifies the project with them and enforces access via firestore.rules.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
